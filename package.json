{
  "name": "lanyard",
  "private": true,
  "version": "0.2.0",
  "description": "Lanyard — iGaming sales desk: leads, deals and distribution reach. ingest/ fetches and shapes data, the Next.js app displays it",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "python3 ingest/seed.py",
    "ingest:sbc-domains": "cd ingest && python3 enrich.py domains",
    "ingest:sbc-contacts": "cd ingest && python3 enrich.py contacts",
    "ingest:browser": "cd ingest && python3 enrich_browser.py",
    "ingest:people": "cd ingest && python3 enrich_people.py && python3 clean_people.py",
    "ingest:g2e": "cd ingest && python3 g2e.py",
    "ingest:calendar": "cd ingest && python3 igc.py fetch && python3 igc.py status",
    "ingest:calendar-upsert": "cd ingest && python3 igc.py upsert",
    "ingest:status": "cd ingest && python3 enrich.py status",
    "test:ingest": "cd ingest && python3 -m unittest discover -p 'test_*.py'"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
